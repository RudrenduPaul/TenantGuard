{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.RudrenduPaul/tenantguard",
  "description": "Scans self-hosted multi-tenant AI-agent platforms for tenant-isolation gaps via an MCP tool.",
  "repository": {
    "url": "https://github.com/RudrenduPaul/TenantGuard",
    "source": "github"
  },
  "version": "0.1.5",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "tenantguard-cli",
      "version": "0.1.5",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--from",
          "value": "tenantguard-cli"
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "valueHint": "script_name",
          "value": "tenantguard"
        },
        {
          "type": "positional",
          "valueHint": "subcommand",
          "value": "mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
